/************************************************************************/
/*  OBJETO: Script dinámico de creación de asistente                    */
/*  DESCRIPCION:                                                        */
/*  Creación de asistente para Producto Certificado Cuentas             */
/*  Permite insertar por múltiples canales e idiomas                    */
/*                                                                      */
/*  NOTA:                                                               */
/*  - Si el registro no existe, lo inserta.                             */
/*  - Si el registro ya existe, no actualiza ni duplica.                */
/*  - Solo muestra mensaje indicando que ya existe.                     */
/************************************************************************/

USE pr_canales
GO

SET NOCOUNT ON
GO

/*=======================================================================
  1. PARÁMETROS CONFIGURABLES
========================================================================*/

DECLARE @Flujo VARCHAR(100) = 'ProductoCertificadoCuentas'

-- Puedes usar: 'IN', 'BK', 'BM', 'IN,BK', 'IN,BK,BM', etc.
DECLARE @Canales VARCHAR(200) = 'IN'

-- Puedes usar: 'es-EC', 'en-US', 'es-EC,en-US' o 'ALL'
DECLARE @Idiomas VARCHAR(200) = 'es-EC,en-US'

/*=======================================================================
  2. TABLAS TEMPORALES DE CONTROL
========================================================================*/

DECLARE @canales TABLE (
    Canal VARCHAR(20) PRIMARY KEY
)

DECLARE @idiomas TABLE (
    Idioma VARCHAR(20) PRIMARY KEY,
    id_id_idioma INT NULL
)

DECLARE @data TABLE (
    Codigo INT,

    UrlAsistente VARCHAR(300),
    UrlOrigen VARCHAR(300),
    UrlCancelar VARCHAR(300),
    UrlContinuar VARCHAR(300),

    TituloEs NVARCHAR(200),
    SubtituloEs NVARCHAR(300),
    TextoCancelarEs NVARCHAR(100),
    TextoContinuarEs NVARCHAR(100),

    TituloEn NVARCHAR(200),
    SubtituloEn NVARCHAR(300),
    TextoCancelarEn NVARCHAR(100),
    TextoContinuarEn NVARCHAR(100),

    Flujo VARCHAR(100),
    Pasos INT,
    PasoActual INT,
    Critico BIT,

    TipoSegundoFactor VARCHAR(50) NULL,
    UrlRegresar VARCHAR(300) NULL
)

DECLARE @rutas TABLE (
    Url VARCHAR(300) PRIMARY KEY,
    Verbo VARCHAR(10),
    CrearMenu BIT,
    MenuNombreEs NVARCHAR(200) NULL,
    MenuNombreEn NVARCHAR(200) NULL,
    Orden INT NULL
)

/*=======================================================================
  3. CARGA DE CANALES
========================================================================*/

INSERT INTO @canales (Canal)
SELECT DISTINCT LTRIM(RTRIM(value))
FROM STRING_SPLIT(@Canales, ',')
WHERE LTRIM(RTRIM(value)) <> ''

IF NOT EXISTS (SELECT 1 FROM @canales)
BEGIN
    RAISERROR('Debe configurar al menos un canal en @Canales.', 16, 1)
    RETURN
END

/*=======================================================================
  4. CARGA DE IDIOMAS
========================================================================*/

IF UPPER(LTRIM(RTRIM(@Idiomas))) = 'ALL'
BEGIN
    INSERT INTO @idiomas (Idioma)
    VALUES ('es-EC'), ('en-US')
END
ELSE
BEGIN
    INSERT INTO @idiomas (Idioma)
    SELECT DISTINCT LTRIM(RTRIM(value))
    FROM STRING_SPLIT(@Idiomas, ',')
    WHERE LTRIM(RTRIM(value)) <> ''
END

UPDATE i
SET i.id_id_idioma = wi.id_id_idioma
FROM @idiomas i
INNER JOIN dbo.wp_idioma wi
    ON wi.id_nemonico = i.Idioma

IF EXISTS (SELECT 1 FROM @idiomas WHERE id_id_idioma IS NULL)
BEGIN
    SELECT 'Idioma no encontrado en dbo.wp_idioma: ' + Idioma AS Error
    FROM @idiomas
    WHERE id_id_idioma IS NULL

    RAISERROR('Existen idiomas configurados que no están registrados en dbo.wp_idioma.', 16, 1)
    RETURN
END

IF EXISTS (
    SELECT 1
    FROM @idiomas
    WHERE Idioma NOT IN ('es-EC', 'en-US')
)
BEGIN
    SELECT 'Idioma sin traducción configurada en el script: ' + Idioma AS Error
    FROM @idiomas
    WHERE Idioma NOT IN ('es-EC', 'en-US')

    RAISERROR('El script solo tiene traducciones configuradas para es-EC y en-US.', 16, 1)
    RETURN
END

